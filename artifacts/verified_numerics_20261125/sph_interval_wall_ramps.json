  "reference": "Two independent piecewise-linear wall temperatures on a homogeneous unit slab. SPH uses default support h/dx=1.3 and exponential time integration split at each ramp knot. Compare particle endpoints to Fourier point temperatures, window means to the analytically time-integrated ramp solution and section heat to differences of cumulative analytical heat. Mean wall temperatures use exact integrals of the piecewise-linear data.",
  "sph_ramp_orders": [
    "particle temperature",
    "interval wall heat",
    "interval interior cut heat",
    "interval mean particle temperature"
  ],
  "reference_quadrature": {
    "method": "Adaptive quad_vec integration of instantaneous Fourier point temperatures, split at knots across six windows and 64 particle centers. Compare interval means with the analytic time primitive. Values indexed by series length.",
    "max_difference_K": {
      "64": 1.6827696690518285e-07,
      "256": 3.357380562798995e-10,
      "512": 1.4158596170488202e-11
    }
  },
