{
  "schema": "lineage_debt_vocab.v1",
  "description": "Injectable vocabulary for the lineage-inheritance debt ledger. Every domain word, quantity alias, table-header token and deny-list term lives HERE (configuration), never in the package logic - the logic stays domain-free so that a different domain can be plugged in by swapping this file.",
  "thresholds": {
    "default_pct": 15.0,
    "by_domain": {
      "campaign_meta": 0.0
    },
    "by_quantity": {}
  },
  "table_contract": {
    "quantity_headers": [
      "量",
      "量名",
      "关键量",
      "指标",
      "quantity",
      "quantity_name",
      "metric",
      "item"
    ],
    "condition_headers": [
      "工况",
      "船型",
      "算例",
      "condition",
      "case",
      "model",
      "state"
    ],
    "error_header_patterns": [
      "误差",
      "error",
      "偏差",
      "相对误差",
      "rel_err",
      "rel error",
      "err"
    ],
    "verdict_markers": {
      "fail": [
        "FAIL",
        "fail",
        "honest FAIL",
        "honest-fail",
        "未通过",
        "不通过"
      ],
      "pass": [
        "PASS",
        "pass",
        "通过"
      ]
    },
    "empty_markers": [
      "",
      "—",
      "-",
      "–",
      "n/a",
      "N/A",
      "na",
      "NaN",
      "nan",
      "None"
    ],
    "fraction_interpretation": true
  },
  "criteria_contract": {
    "threshold_patterns": [
      "(?P<qty>[^,;，；|]+?)\\s*[<≤]=?\\s*(?P<val>\\d+(?:\\.\\d+)?)\\s*%",
      "(?P<qty>[^,;，；|]+?)\\s*(?:误差|error|偏差)\\s*[<≤]=?\\s*(?P<val>\\d+(?:\\.\\d+)?)(?!\\s*%)"
    ],
    "ref_patterns": {
      "mission": [
        "\\bm(?P<v>\\d{3,6})\\b",
        "\\bmission\\s*#?(?P<v>\\d{3,6})\\b"
      ],
      "node": [
        "\\bnode\\s*#?(?P<v>\\d{2,6})\\b",
        "\\bnode_id\\s*[=:]\\s*(?P<v>\\d{2,6})\\b"
      ],
      "report": [
        "\\breport\\s*#?(?P<v>\\d{3,6})\\b",
        "\\breport_id\\s*[=:]\\s*(?P<v>\\d{3,6})\\b"
      ],
      "plan": [
        "\\bplan\\s*#?(?P<v>\\d{2,6})\\b",
        "\\bplan_id\\s*[=:]\\s*(?P<v>\\d{2,6})\\b"
      ]
    }
  },
