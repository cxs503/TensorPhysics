{
  "schema": "tensorphysics.metrology.criteria.controls/1",
  "note": "Negative-control corpus for the criterion degeneracy classifier (P266W2-N09). 12 degenerate criteria (4 per type) and 12 benign ones. Benign specimens encode the two traps named in the goal: 1e-6-level consistency and a legitimate zero reference where the measurand is also at zero (judged with an absolute band, i.e. no division). Shadow rows exist only to make the T3 family carry two competing metric kinds; they are excluded from scoring.",
  "degenerate": [
    {
      "id": "D-T1-1",
      "type": "T1",
      "expect_classes": [
        "T1_zero_reference"
      ],
      "expect_verdict": "FAIL",
      "criterion": "相对误差 < 5%",
      "y": 3.0,
      "y_ref": 0.0,
      "scale": 3.0,
      "note": "reference exactly zero: relative denominator collapses, ratio is unbounded"
    },
    {
      "id": "D-T1-2",
      "type": "T1",
      "expect_classes": [
        "T1_zero_reference"
      ],
      "expect_verdict": "PASS",
      "criterion": "相对误差 < 1%",
      "y": 0.001,
      "y_ref": 1e-09,
      "scale": 1.0,
      "note": "reference nine decades below the engineering scale: 1e6 relative error is noise, deviation is 0.1% of scale"
    },
    {
      "id": "D-T1-3",
      "type": "T1",
      "expect_classes": [
        "T1_zero_reference"
      ],
